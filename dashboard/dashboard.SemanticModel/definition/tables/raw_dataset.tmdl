	measure 'Most Sold Subcategory' = ```
			
			FIRSTNONBLANK(
			    TOPN(
			        1, 
			        VALUES('raw_dataset'[Sub-Category]), 
			        [Total Sales], 
			        DESC
			    ),
			    1
			)
			```
		lineageTag: 59aa2573-a8c3-4ca0-8253-ac0554d81507

	measure 'Most Profitable Subcategory' = ```
			
			FIRSTNONBLANK(
			    TOPN(
			        1, 
			        VALUES('raw_dataset'[Sub-Category]), 
			        [Total Profit], 
			        DESC
			    ),
			    1
			)
			```
		lineageTag: d18d7c70-a7f7-4aa6-9cf0-d63e1447e687

	measure 'Least Sold Subcategory' = ```
			
			FIRSTNONBLANK(
			    TOPN(
			        1, 
			        VALUES('raw_dataset'[Sub-Category]), 
			        [Total Sales], 
			        ASC
			    ),
			    1
			)
			```
		lineageTag: 0649183b-7c97-467a-9602-6aa5a22cf840

	measure 'Least Profitable Subcategory' = ```
			
			FIRSTNONBLANK(
			    TOPN(
			        1, 
			        VALUES('raw_dataset'[Sub-Category]), 
			        [Total Profit], 
			        ASC
			    ),
			    1
			)
			```
